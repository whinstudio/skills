#!/bin/bash
# Compass unity-kit: compile + tests in Unity batchmode; prints only compiler errors and a test summary.
#   ./compass-unity check   compile + EditMode tests
#   ./compass-unity play    compile + PlayMode tests (the gameplay test included)
# Exit: 0 green, 1 compile errors / no results, 2 tests failed, 64 usage, 75 project open in the Unity Editor.
set -u
UNITY='@UNITY@'
ROOT="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}" in
  check) PLATFORM=EditMode ;;
  play) PLATFORM=PlayMode ;;
  *) echo "usage: ./compass-unity check|play"; exit 64 ;;
esac
LOG="$ROOT/Logs/compass-$1.log"
XML="$ROOT/Logs/compass-$1.xml"
mkdir -p "$ROOT/Logs"
rm -f "$XML"
# -runTests without -quit: Unity exits by itself when the tests end.
"$UNITY" -batchmode -nographics -projectPath "$ROOT" -logFile "$LOG" \
  -runTests -testPlatform "$PLATFORM" -testResults "$XML" >/dev/null 2>&1
CODE=$?
if grep -qE 'another Unity instance is running|Multiple Unity instances cannot open the same project' "$LOG" 2>/dev/null; then
  echo "UNITY_LOCKED: the project is open in the Unity Editor. Stop and tell the owner to close it."
  exit 75
fi
if [ ! -f "$XML" ]; then
  ERRORS="$(grep -E '^[^ ]+\.cs\([0-9]+,[0-9]+\): error CS[0-9]+' "$LOG" 2>/dev/null | sort -u | head -n 40)"
  if [ -n "$ERRORS" ]; then
    echo "COMPILE ERRORS:"
    echo "$ERRORS"
  else
    echo "NO TEST RESULTS (Unity exit $CODE). Last log lines:"
    tail -n 20 "$LOG" 2>/dev/null
  fi
  exit 1
fi
awk '
/<test-run /{ match($0,/total="[0-9]+"/); t=substr($0,RSTART+7,RLENGTH-8);
  match($0,/passed="[0-9]+"/); p=substr($0,RSTART+8,RLENGTH-9);
  match($0,/failed="[0-9]+"/); f=substr($0,RSTART+8,RLENGTH-9) }
/<test-case .*result="Failed/{ inf=1; match($0,/fullname="[^"]*"/); name=substr($0,RSTART+10,RLENGTH-11); next }
inf && /<message>/{ m=$0; sub(/.*<message><!\[CDATA\[/,"",m); sub(/\]\]>.*/,"",m); fails[++n]="FAILED " name ": " m; inf=0 }
END{ print "TESTS total=" t " passed=" p " failed=" f; for(i=1;i<=n && i<=20;i++) print fails[i] }' "$XML"
grep -q 'total="0"' "$XML" && { echo "NO TESTS RAN"; exit 1; }
[ "$CODE" -eq 0 ] && exit 0
exit 2
